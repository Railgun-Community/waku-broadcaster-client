{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "no-console": "error",
    "typescript/no-explicit-any": "error",
    "import/no-cycle": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/pkg/**",
    "**/node_modules/**",
    "packages/waku-client-common/src/**",
    "packages/waku-client-common/copy-src.js",
    "packages/waku-client-node/src/**",
    "packages/waku-client-web/src/**"
  ]
}
