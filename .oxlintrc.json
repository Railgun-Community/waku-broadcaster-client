{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "no-console": "error",
    "typescript/no-explicit-any": "error",
    "import/no-cycle": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/pkg/**",
    "**/node_modules/**",
    "packages/waku-client-common/src/__tests__/**",
    "packages/waku-client-common/src/fees/**",
    "packages/waku-client-common/src/filters/**",
    "packages/waku-client-common/src/index.ts",
    "packages/waku-client-common/src/models/**",
    "packages/waku-client-common/src/search/**",
    "packages/waku-client-common/src/status/**",
    "packages/waku-client-common/src/tests/**",
    "packages/waku-client-common/src/transact/**",
    "packages/waku-client-common/src/types/**",
    "packages/waku-client-common/src/utils/**",
    "packages/waku-client-common/src/waku/**",
    "packages/waku-client-common/src/waku-broadcaster-client.ts",
    "packages/waku-client-common/copy-src.js",
    "packages/waku-client-node/src/**",
    "packages/waku-client-web/src/**"
  ]
}
